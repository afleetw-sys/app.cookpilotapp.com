NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Default Storage bucket — must match the bucket where Storage rules are published.
# Legacy (pre–Sep 2024): cookpilot-bbecb.appspot.com
# Gen 2 default: cookpilot-bbecb.firebasestorage.app
# In Firebase Console → Storage, use the bucket selector to see which bucket has your rules.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cookpilot-bbecb.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Firebase App Check — required; Storage bucket has enforcement enabled.
# Development: leave NEXT_PUBLIC_RECAPTCHA_SITE_KEY blank.
#   Start the app, find "App Check debug token: <uuid>" in the browser console,
#   register that UUID in Firebase Console → App Check → Apps → [CookPilot Web] → Manage debug tokens,
#   then paste the UUID below so it's stable across sessions.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
# Production: reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
